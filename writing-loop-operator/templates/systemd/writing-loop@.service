[Unit]
Description=writing-loop scheduler for project %i
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dramas   # ← 改成你的 workspace 路径
Environment=PATH=%h/.npm-global/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=WRITING_LOOP_WORKSPACE=%h/dramas   # ← 改成你的 workspace 路径
ExecStart=%h/.npm-global/bin/writing-loop run --project %i
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=90

[Install]
WantedBy=default.target
